---
import { Image } from "astro:assets";
import plant from "../../assets/img/plant.jpg";
import food from "../../assets/img/food.jpg";
import styles from "./homepage.module.scss";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div>
  <main>
    <section class={styles.homepage__title}>
      <h1>Dame Eugénie</h1>
    </section>
    <section class={styles.homepage__section}>
      <a class={styles.homepage__card} href="#">
        <Image
          src={plant}
          class={styles.homepage__card__image}
          alt="Plantes"
          width="300"
          decoding="async"
          loading="lazy"
        />
        <p class={styles.homepage__card__text}>Plantes</p>
      </a>
      <a class={styles.homepage__card} href={`${baseUrl}/recipies/`}>
        <Image
          src={food}
          class={styles.homepage__card__image}
          alt="Recettes"
          width="375"
          decoding="async"
          loading="lazy"
        />
        <p class={styles.homepage__card__text}>Recettes</p>
      </a>
    </section>
  </main>
</div>
